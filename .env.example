# ColdChain 360 Backend Environment Configuration
# Copy this file to .env and fill in real values.

# Application
DEBUG=True
# SECRET_KEY: generate a strong random string (e.g., powershell -Command "Get-Random -Maximum 99999999 | % { [char](65+($_%32)) } -Join ''")
SECRET_KEY=change-this-to-a-secret-key

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
# ====================================================
# Obtain your Supabase PostgreSQL connection string from:
#   Supabase Dashboard → Connect → Connection String (Python)
# Replace placeholder values with your actual Supabase credentials:
#   - POSTGRES_PASSWORD: from Supabase Dashboard → Settings → Database → Password
#   - db.xxx.supabase.co: your project's database host
#   - 5432: standard PostgreSQL port
#   - postgres: default database name
# ====================================================
# Example format (replace all placeholder values, URL-encode password if it contains special characters like @ -> %40):
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# CORS
# Comma-separated list of allowed origins (use * for all or your frontend Vercel/Netlify URL)
BACKEND_CORS_ORIGINS=*

# Password hashing
BCRYPT_ROUNDS=12